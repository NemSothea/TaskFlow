# Copy to .env and adjust. Never commit the real .env.

# Generate with: uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# The app refuses to start with this placeholder. scripts/dev.sh replaces it for you.
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://taskflow:taskflow_dev_password@127.0.0.1:5433/taskflow

# Local dev runs over plain HTTP, so secure cookies must be off here.
# Keep True (the default) in any HTTPS environment.
SECURE_COOKIES=False

# Only needed if the frontend is served from a different origin than the API.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production hardening (leave defaults for local dev)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
BEHIND_TLS_PROXY=False

ACCESS_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=7
AUTH_THROTTLE_RATE=10/min
REFRESH_THROTTLE_RATE=30/min
